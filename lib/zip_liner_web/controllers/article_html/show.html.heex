<div class="mb-4">
  <%= if @current_member do %>
    <a href={~p"/articles"} class="text-decoration-none text-muted small">← Back to Articles</a>
  <% end %>
</div>

<script>
  function toggleCommentEdit(id) {
    document.getElementById('edit-form-' + id).classList.toggle('d-none');
    document.getElementById('comment-body-' + id).classList.toggle('d-none');
  }
</script>

<div class="row justify-content-center">
  <div class="col-12 col-md-9 col-lg-8">
    <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2 bg-white">
        <img src={@article.author.github_avatar_url} alt={@article.author.display_name} class="avatar-sm" />
        <div class="flex-grow-1">
          <%= if @current_member do %>
            <a href={~p"/members/#{@article.author.id}"} class="fw-semibold text-decoration-none text-dark">
              <%= @article.author.display_name %>
            </a>
          <% else %>
            <span class="fw-semibold"><%= @article.author.display_name %></span>
          <% end %>
          <%= if @article.author.blog_title do %>
            <br />
            <span class="small text-muted fst-italic"><%= @article.author.blog_title %></span>
          <% end %>
          <br />
          <time class="small text-muted" datetime={DateTime.to_iso8601(@article.inserted_at)}>
            <%= Calendar.strftime(@article.inserted_at, "%B %d, %Y") %>
          </time>
        </div>
        <div class="d-flex align-items-center gap-2">
          <%= if @article.visibility == :public do %>
            <span class="badge text-bg-success">Public</span>
          <% else %>
            <span class="badge text-bg-secondary">Private</span>
          <% end %>
          <%= if @current_member && (@current_member.id == @article.author_id or @current_member.is_admin) do %>
            <a href={~p"/articles/#{@article.id}/edit"} class="btn btn-sm btn-outline-secondary">Edit</a>
            <form method="post" action={~p"/articles/#{@article.id}"} class="d-inline m-0">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <input type="hidden" name="_method" value="delete" />
              <button type="submit" class="btn btn-sm btn-outline-danger"
                onclick="return confirm('Delete this article and all its comments?')">Delete</button>
            </form>
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <h1 class="h4 fw-bold mb-4"><%= @article.title %></h1>
        <div class="markdown-body"><%= ZipLiner.Markdown.to_html(@article.body) %></div>
      </div>
    </div>

    <h2 class="h6 fw-semibold mb-3">
      <%= length(@article.comments) %> <%= if length(@article.comments) == 1, do: "Comment", else: "Comments" %>
    </h2>

    <div id="article-comments">
      <%= for comment <- @article.comments do %>
        <div class="d-flex gap-3 mb-3" id={"comment-#{comment.id}"}>
          <img src={comment.author.github_avatar_url} alt={comment.author.display_name} class="avatar-sm flex-shrink-0 mt-1" />
          <div class="flex-grow-1">
            <div class="card">
              <div class="card-header d-flex justify-content-between align-items-center bg-white py-2">
                <div>
                  <%= if @current_member do %>
                    <a href={~p"/members/#{comment.author.id}"} class="fw-semibold text-decoration-none text-dark small">
                      <%= comment.author.display_name %>
                    </a>
                  <% else %>
                    <span class="fw-semibold small"><%= comment.author.display_name %></span>
                  <% end %>
                  <span class="text-muted small ms-2">@<%= comment.author.github_username %></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <time class="small text-muted" datetime={DateTime.to_iso8601(comment.inserted_at)}>
                    <%= Calendar.strftime(comment.inserted_at, "%b %d, %Y") %>
                  </time>
                  <%= if @current_member && (@current_member.id == comment.author_id or @current_member.is_admin) do %>
                    <div class="d-flex align-items-center gap-2">
                      <button
                        type="button"
                        class="btn btn-sm btn-link text-secondary p-0"
                        data-comment-id={comment.id}
                        onclick="toggleCommentEdit(this.dataset.commentId)"
                      >Edit</button>
                      <form method="post" action={~p"/articles/#{@article.id}/comments/#{comment.id}"} class="d-inline m-0">
                        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                        <input type="hidden" name="_method" value="delete" />
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0"
                          onclick="return confirm('Delete this comment?')">Delete</button>
                      </form>
                    </div>
                  <% end %>
                </div>
              </div>
              <div class="card-body py-2">
                <div id={"comment-body-#{comment.id}"} class="markdown-body small"><%= ZipLiner.Markdown.to_html(comment.body) %></div>
                <form
                  id={"edit-form-#{comment.id}"}
                  class="d-none"
                  method="post"
                  action={~p"/articles/#{@article.id}/comments/#{comment.id}"}
                >
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <input type="hidden" name="_method" value="patch" />
                  <textarea
                    name="article_comment[body]"
                    rows="4"
                    maxlength="5000"
                    class="form-control form-control-sm mb-2"
                    required
                  ><%= comment.body %></textarea>
                  <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-secondary"
                      data-comment-id={comment.id}
                      onclick="toggleCommentEdit(this.dataset.commentId)"
                    >Cancel</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%= if @current_member do %>
      <div class="card mt-4">
        <div class="card-header bg-white fw-semibold">Add a Comment</div>
        <div class="card-body">
          <p class="small text-muted mb-3">
            Use <code>@username</code> to mention members and notify them.
          </p>
          <form method="post" action={~p"/articles/#{@article.id}/comments"}>
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <div class="mb-3">
              <textarea
                name="article_comment[body]"
                rows="4"
                maxlength="5000"
                class="form-control"
                placeholder="Write your comment… Use @username to mention someone."
                required
              ></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Post Comment</button>
          </form>
        </div>
      </div>
    <% else %>
      <div class="card mt-4">
        <div class="card-body text-center text-muted py-4">
          <p class="mb-2">Sign in to leave a comment.</p>
          <a href={~p"/auth/github"} class="btn btn-outline-primary btn-sm">Sign in with GitHub</a>
        </div>
      </div>
    <% end %>
  </div>
</div>

