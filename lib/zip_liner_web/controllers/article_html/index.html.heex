<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Articles</h1>
  <a href={~p"/articles/new"} class="btn btn-primary">Write an Article</a>
</div>

<%= if @articles == [] do %>
  <div class="text-center text-muted py-5">
    <p class="mb-3">No articles yet. Be the first to write one!</p>
    <a href={~p"/articles/new"} class="btn btn-outline-primary">Write an Article</a>
  </div>
<% else %>
  <div class="list-group">
    <%= for article <- @articles do %>
      <a href={~p"/articles/#{article.id}"} class="list-group-item list-group-item-action py-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h2 class="h6 mb-1 fw-semibold"><%= article.title %></h2>
            <div class="d-flex align-items-center gap-2 small text-muted">
              <img src={article.author.github_avatar_url} alt={article.author.display_name} class="avatar-xs" />
              <span><%= article.author.display_name %></span>
              <%= if article.author.blog_title do %>
                <span>·</span>
                <span class="fst-italic"><%= article.author.blog_title %></span>
              <% end %>
              <span>·</span>
              <time datetime={DateTime.to_iso8601(article.inserted_at)}>
                <%= Calendar.strftime(article.inserted_at, "%b %d, %Y") %>
              </time>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2 ms-3">
            <%= if article.visibility == :pinned do %>
              <span class="badge text-bg-warning"><span aria-hidden="true">📌</span> Pinned</span>
            <% else %>
              <%= if article.visibility == :public do %>
                <span class="badge text-bg-success">Public</span>
              <% else %>
                <span class="badge text-bg-secondary">Private</span>
              <% end %>
            <% end %>
            <span class="badge text-bg-light border">
              <%= length(article.comments) %> <%= if length(article.comments) == 1, do: "comment", else: "comments" %>
            </span>
          </div>
        </div>
      </a>
    <% end %>
  </div>
<% end %>
