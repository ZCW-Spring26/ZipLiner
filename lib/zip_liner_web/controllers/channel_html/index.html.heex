<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Blogs</h1>
  <a href={~p"/articles/new"} class="btn btn-primary">Write a Post</a>
</div>

<p class="text-muted mb-4">Each member's blog is their personal space for long-form articles and reflections. Pinned and public posts appear on the <a href={~p"/articles"}>Articles</a> page.</p>

<%= if @blog_members == [] do %>
  <div class="text-center text-muted py-5">
    <p class="mb-3">No blogs yet. Be the first to write an article!</p>
    <a href={~p"/articles/new"} class="btn btn-outline-primary">Write an Article</a>
  </div>
<% else %>
  <div class="list-group">
    <%= for {member, article_count} <- @blog_members do %>
      <a href={~p"/channels/#{member.id}"} class="list-group-item list-group-item-action py-3">
        <div class="d-flex align-items-center gap-3">
          <img src={member.github_avatar_url} alt={member.display_name} class="avatar-sm flex-shrink-0" />
          <div class="flex-grow-1">
            <div class="fw-semibold">
              <%= if member.blog_title do %>
                <%= member.blog_title %>
              <% else %>
                <%= member.display_name %>'s Blog
              <% end %>
            </div>
            <div class="small text-muted">by <%= member.display_name %></div>
          </div>
          <span class="badge text-bg-light border ms-auto">
            <%= article_count %> <%= if article_count == 1, do: "post", else: "posts" %>
          </span>
        </div>
      </a>
    <% end %>
  </div>
<% end %>
